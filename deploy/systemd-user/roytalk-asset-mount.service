# ~/.config/systemd/user/roytalk-asset-mount.service  (optional)
# rclone mount of the private R2 bucket at <app>/prv/asset-private
# Set RCLONE_REMOTE to your remote:path (created with `rclone config`).
#   systemctl --user enable --now roytalk-asset-mount
#
# Mounting as a normal user needs FUSE: install fuse3, and for other users to
# read the mount, add `user_allow_other` to /etc/fuse.conf.

[Unit]
Description=rclone mount of the private R2 bucket for roytalk
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
Environment=ROYTALK_DIR=/srv/roytalk
Environment=RCLONE_REMOTE=r2:private
ExecStartPre=/bin/mkdir -p ${ROYTALK_DIR}/prv/asset-private
ExecStart=/usr/bin/rclone mount ${RCLONE_REMOTE} ${ROYTALK_DIR}/prv/asset-private \
  --vfs-cache-mode writes \
  --dir-cache-time 1m \
  --umask 077
ExecStop=/bin/fusermount3 -u ${ROYTALK_DIR}/prv/asset-private
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
