# /etc/cloudflared/config.yml -- Cloudflare Tunnel to the app.
# With a tunnel the VM needs no open inbound port at all, and nobody can reach
# the app except through Cloudflare (so CF-Connecting-IP can be trusted).
#   cloudflared tunnel login
#   cloudflared tunnel create roytalk
#   cloudflared tunnel route dns roytalk roytalk.com
tunnel: roytalk
credentials-file: /etc/cloudflared/roytalk.json
ingress:
  # nginx (deploy/nginx-roytalk.conf), which proxies to the app on :3000.
  - hostname: roytalk.com
    service: http://127.0.0.1:8080
  - service: http_status:404
